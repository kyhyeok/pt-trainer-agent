{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pt-trainer-agent",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// 로그(enabled)와 트레이스(traces)는 따로 켠다. 트레이스의 대화 내용은 app.ts에서 끈다(content: false)
	"observability": { "enabled": true, "traces": { "enabled": true } },
	// cloudflare/... 모델은 이 Workers AI 바인딩으로 호출한다. 로컬 개발에서도 실제 계정 사용량으로 잡힌다
	"ai": { "binding": "AI" },
	// 비밀이 아닌 설정. 토큰(AGENT_TOKEN)은 .dev.vars 또는 `wrangler secret put`으로 넣는다
	"vars": { "ALLOWED_ORIGIN": "http://localhost:5173" },
	// 에이전트마다 Durable Object 클래스가 생긴다. agentName 'pt-trainer' → FluePtTrainerAgent
	// 배포한 항목은 고치지 말고 새 태그를 추가한다
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FluePtTrainerAgent"] }]
}
